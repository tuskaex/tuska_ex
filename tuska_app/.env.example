# Copy to `.env` before running the dev server.
#
# The file must EXIST even if every value is blank: babel.config.js wires
# react-native-dotenv with `path: '.env'`, and the transform reads that file
# at build time. Missing file = the bundler fails on the first `@env` import,
# which surfaces as an unrelated-looking module resolution error.
#
# All three are optional. src/constants/api.js derives what you leave out:
# API_URL defaults to `${API_BASE_URL}/api/v1`, and WS_URL swaps the scheme
# on API_BASE_URL for ws/wss. In practice you only set API_BASE_URL.

# The gateway. Omit to fall back to the production host baked into
# src/constants/api.js (https://api.tuskaex.com).
API_BASE_URL=https://api.tuskaex.com

# Override only when the REST base is not `<API_BASE_URL>/api/v1`.
API_URL=

# Override only when the socket is not on the same host as the API.
WS_URL=
