# TuskaEx — example environment file.
#
# Copy to `.env` and fill in real values. NEVER put real credentials in
# this file: `.env.example` is committed to git; `.env` is gitignored.
# Generate strong secrets with:  openssl rand -hex 32   (JWT secrets)
#                                openssl rand -base64 24 (passwords)

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=tuskaex
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=tuskaex

# ─── TimescaleDB ──────────────────────────────────────────────
TIMESCALE_USER=tuskaex
TIMESCALE_PASSWORD=CHANGE_ME
TIMESCALE_DB=marketdata

# ─── Connection URLs (must match passwords above) ─────────────
DATABASE_URL=postgresql+asyncpg://tuskaex:CHANGE_ME@postgres:5432/tuskaex
TIMESCALE_URL=postgresql+asyncpg://tuskaex:CHANGE_ME@timescaledb:5432/marketdata
REDIS_URL=redis://redis:6379/0
ADMIN_REDIS_URL=redis://redis:6379/1

# ─── JWT secrets (openssl rand -hex 32; each one DIFFERENT) ───
# Production boot refuses empty/short/known-placeholder values.
JWT_SECRET=
USER_JWT_SECRET=
ADMIN_JWT_SECRET=
JWT_ACCESS_EXPIRY_MINUTES=45
JWT_REFRESH_EXPIRY_DAYS=7
# true = browser-session cookies (close browser → log in again)
JWT_REFRESH_SESSION_COOKIE=false

# ─── Cookies (production HTTPS) ───────────────────────────────
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
# Parent domain so the session works on apex + trade subdomain.
# Local dev: leave blank (host-only cookies on localhost are correct).
COOKIE_DOMAIN=.tuskaex.com
# Every parent domain a session may be issued on, comma-separated. Needed
# because the terminal moved to speedtrade.tech: a .tuskaex.com cookie is
# never sent to a different registrable domain, so the Domain attribute is
# picked per request from the host actually being served. Only the
# /auth/handoff/redeem flow can create a session on the non-primary domain.
# Leave blank to keep the old single-COOKIE_DOMAIN behaviour.
COOKIE_DOMAINS=.tuskaex.com,.speedtrade.tech

# ─── Environment & CORS ───────────────────────────────────────
ENVIRONMENT=production
# speedtrade.tech MUST be listed: the terminal's WebSocket handshakes
# are rejected with close code 4003 when their Origin is not here, and
# assert_same_origin rejects its auth POSTs the same way.
CORS_ORIGINS=https://tuskaex.com,https://www.tuskaex.com,https://trade.tuskaex.com,https://admin.tuskaex.com,https://speedtrade.tech
TRADER_APP_URL=https://trade.tuskaex.com
NEXT_PUBLIC_MARKETING_HOST=tuskaex.com
NEXT_PUBLIC_TRADE_HOST=trade.tuskaex.com
# White-label sub-brokers. Off (the code default) disables every branding route
# and treats every user as a platform user: no broker names, logos, colours or
# broker-specific mail. Must be true wherever sub-brokers are in use.
BRANDING_ENABLED=true
# The platform's own web hosts. A white-label broker's client whose broker has
# a live domain is refused sign-in on these and sent to that domain instead.
PLATFORM_WEB_HOSTS=tuskaex.com,www.tuskaex.com,trade.tuskaex.com,speedtrade.tech,www.speedtrade.tech
# The server's public IP: the A-record target a broker points their domain at.
# Shown in the admin panel's DNS instructions and by tenant-provisioner.sh.
# Empty disables the custom-domain section.
PLATFORM_PUBLIC_IP=

# ─── Trading terminal on its own domain ───────────────────────
# tuskaex.com keeps the CRM; the terminal is served from here. Blank both to
# put the terminal back in-app on tuskaex.com (this is the rollback switch).
# TERMINAL_APP_URL is read by the gateway, NEXT_PUBLIC_TERMINAL_ORIGIN by the
# trader frontend — and the latter is BAKED AT BUILD TIME, so changing it
# needs `docker compose build trader-frontend`, not just a restart.
TERMINAL_APP_URL=https://speedtrade.tech
NEXT_PUBLIC_TERMINAL_ORIGIN=https://speedtrade.tech
# Lifetime of a single-use cross-domain handoff code. It rides in a URL, so
# short is the point: long enough for a redirect, too short to be worth stealing.
HANDOFF_TTL_SECONDS=60

# ─── Risk engine ──────────────────────────────────────────────
MARGIN_CALL_LEVEL=80.0
STOP_OUT_LEVEL=50.0
MAX_OPEN_TRADES=200
DEFAULT_LEVERAGE=100

# ─── HTTP hardening ───────────────────────────────────────────
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Requested-With,Accept
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_TRADING=120/minute
MAX_REQUEST_SIZE=10485760

# ─── Sentry (leave DSN empty to disable) ──────────────────────
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── SMTP (password reset / notification email) ───────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TuskaEx <support@example.com>

# ─── Optional integrations ────────────────────────────────────
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false
NOWPAYMENTS_CALLBACK_BASE_URL=https://api.tuskaex.com
TRON_API_URL=https://api.trongrid.io
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Market data (Infoway.io; empty = crypto-only fallback) ───
INFOWAY_API_KEY=
INFOWAY_API_URL=https://api.infoway.io

# ─── Market data (PrimeXM XCore, FIX 4.4) ─────────────────────
# Takes precedence over Infoway when enabled. Copy the values from the
# "Pricing" block of the connection JSON PrimeXM sends you. Never commit them.
PRIMEXM_PRICING_ENABLED=false
PRIMEXM_PRICING_HOST=
PRIMEXM_PRICING_PORT=
PRIMEXM_PRICING_SENDER_COMP_ID=
PRIMEXM_PRICING_TARGET_COMP_ID=
PRIMEXM_PRICING_USERNAME=
PRIMEXM_PRICING_PASSWORD=
PRIMEXM_PRICING_SSL=false
# Extra name pairs when PrimeXM's symbol isn't the platform's minus "/":
# PRIMEXM_SYMBOL_ALIASES=XNG/USD=NGAS

# PrimeXM trading session, held by the lp-bridge service: the "Trading" block
# of the same JSON. It logs on and stays connected; it sends no orders.
PRIMEXM_TRADING_ENABLED=false
PRIMEXM_TRADING_HOST=
PRIMEXM_TRADING_PORT=
PRIMEXM_TRADING_SENDER_COMP_ID=
PRIMEXM_TRADING_TARGET_COMP_ID=
PRIMEXM_TRADING_USERNAME=
PRIMEXM_TRADING_PASSWORD=
PRIMEXM_TRADING_SSL=true
# Optional XCore account name: logs a balance/positions snapshot after logon.
PRIMEXM_TRADING_ACCOUNT=

# ─── Admin seed (alembic revision 0002) ───────────────────────
# NO default password: generate with `openssl rand -base64 24`.
# Migration 0002 refuses to seed if empty or a historical example value;
# production boot refuses known-weak values (packages/common/src/config.py).
ADMIN_EMAIL=admin@tuskaex.com
ADMIN_PASSWORD=

# ─── Razorpay (INR card/UPI deposits) ─────────────────────────
# Dashboard → Settings → API Keys / Webhooks. Leave empty to disable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
USD_TO_INR_RATE=95

# ─── OxaPay (legacy crypto PSP) ───────────────────────────────
OXAPAY_MERCHANT_KEY=
OXAPAY_CALLBACK_BASE_URL=https://api.tuskaex.com

# ─── Crypto deposit verification (all optional) ───────────────
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
TRONGRID_API_KEY=
ALCHEMY_API_URL=
BSC_RPC_URL=

# ─── Backups ──────────────────────────────────────────────────
BACKUP_LOCAL_DIR=/opt/tuskaex/backups
BACKUP_RETENTION_DAYS=14
BACKUP_RCLONE_REMOTE=
# MUST be set in production — backups contain KYC docs + PII.
BACKUP_GPG_PASSPHRASE=
